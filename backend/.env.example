# Required. Set a unique, strong value in your local backend/.env file.
JWT_SECRET=replace-with-a-strong-random-secret

# Optional. Defaults to 1d.
JWT_EXPIRES_IN=1d

# Comma-separated browser origins for production deployments.
FRONTEND_ORIGINS=https://your-frontend.example.com

CLOUDINARY_CLOUD_NAME=your

CLOUDINARY_API_KEY=your

CLOUDINARY_API_SECRET=your